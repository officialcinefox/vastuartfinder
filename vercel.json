{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/admin%20login",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/admin.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/admin.html"
    }
  ]
}
